# SSH_PASSWORD=123

# OPENROUTER_API=
# NVIDIA_API_KEY=
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=

# # WAJIB: isi dengan email/URL kontak aslimu (kebijakan Nominatim/Overpass)
# OSM_CONTACT=
# # opsional, default sudah ada
# # OSM_USER_AGENT=AIRA-OS/1.0 (personal network assistant; contact: emailmu@gmail.com)
# MAPS_PROVIDER=openstreetmap

# # Matikan reasoning/thinking di semua panggilan LLM (opt-in; kalau jawaban terasa
# # menurun kualitasnya, hapus baris ini).
# AIRA_DISABLE_THINKING=1

# # Pakai model kecil untuk classifier: isi dengan ID model dari halaman Models,
# # mis. entri "Qwen3 1.7B (Ollama)" -> id-nya "qwen3_1_7b_ollama"
# # AIRA_CLASSIFIER_MODEL=qwen3_1_7b_ollama