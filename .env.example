# ==============================================================================
# VERA — Production Environment Configuration
# Enterprise Network Intelligence Platform (Understand. Monitor. Automate.)
# Note: Backward compatibility is preserved: all VERA_* variables fall back to AIRA_*
# ==============================================================================

# Application Environment
VERA_ENV=production
AIRA_ENV=production
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Security & CORS
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
VERA_SECRET_KEY=
AIRA_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Storage & Paths (defaults to SQLite and workspace relative paths)
TOPOLOGY_DB_PATH=/app/VERA_ECOSYSTEM/database/topology.db
WORKSPACE_ROOT=/app/workspace
AUDIT_LOG_PATH=/app/VERA_ECOSYSTEM/logs/audit.log

# LLM Providers & API Keys (Configure according to your deployment)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# AI Model Defaults
VERA_DEFAULT_MODEL=qwen/qwen-2.5-72b-instruct
AIRA_DEFAULT_MODEL=qwen/qwen-2.5-72b-instruct
VERA_CLASSIFIER_MODEL=qwen/qwen-2.5-7b-instruct
AIRA_CLASSIFIER_MODEL=qwen/qwen-2.5-7b-instruct
VERA_DISABLE_THINKING=0
AIRA_DISABLE_THINKING=0

# OpenStreetMap / Nominatim Configuration
OSM_CONTACT=admin@example.com
OSM_USER_AGENT=VERA/1.0 (network-intelligence; contact: admin@example.com)
MAPS_PROVIDER=openstreetmap

# Memory & Process Optimization
MAX_CONCURRENT_OPERATIONS=4
WEBSOCKET_PING_INTERVAL=20
SESSION_EXPIRATION_HOURS=72
