<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="100%" height="100%" fill="none">
  <defs>
    <linearGradient id="v-fav-grad" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#54D6FF" />
      <stop offset="100%" stop-color="#176BFF" />
    </linearGradient>
  </defs>

  <!-- Deep Background Disc -->
  <rect width="32" height="32" rx="7" fill="#071426" />

  <!-- V Network Conduction Vectors -->
  <path d="M7 8 L16 25 L25 8" stroke="url(#v-fav-grad)" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
  
  <!-- Internal Cross Bus -->
  <line x1="10" y1="13" x2="22" y2="13" stroke="#54D6FF" stroke-width="1.2" opacity="0.75" />

  <!-- Intelligence Nexus Node -->
  <circle cx="16" cy="13" r="2.8" fill="#54D6FF" />
  <circle cx="16" cy="13" r="1.2" fill="#EAF2FF" />

  <!-- Corner Graph Nodes -->
  <circle cx="7" cy="8" r="1.6" fill="#071426" stroke="#54D6FF" stroke-width="1.2" />
  <circle cx="25" cy="8" r="1.6" fill="#071426" stroke="#54D6FF" stroke-width="1.2" />
  <circle cx="16" cy="25" r="1.8" fill="#176BFF" />
</svg>
